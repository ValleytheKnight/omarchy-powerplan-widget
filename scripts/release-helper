#!/usr/bin/python3
"""Build and sign one immutable release of the privileged helper.

Maintainer-only. Run from the repository root whenever
powerplan-configure-hibernate changes:

    ./scripts/release-helper --key A8238083DE096BC875CD1EB572BD2077B316056A

This builds the package with makepkg and signs it with a detached
signature. The result is one exact, versioned artifact: a specific
pkgver's package plus its signature, nothing else.

There is deliberately no pacman repository and no rolling "latest"
channel. Each pkgver in packaging/pkgbuild/PKGBUILD gets its own GitHub
release tag (helper-v<pkgver>) and its own immutable download URL, so a
security review of one submission can never be stretched to cover a
later helper nobody reviewed. Moving a user to a new helper version
means writing a new commit, a new README section with a new SHA-256,
and going through review again, not an unattended pacman -Syu.

After running this, commit packaging/release/ and publish it with the
exact command printed at the end.
"""
import argparse
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PKGBUILD_DIR = ROOT / "packaging" / "pkgbuild"
PKGBUILD = PKGBUILD_DIR / "PKGBUILD"
RELEASE_DIR = ROOT / "packaging" / "release"


def run(cmd, **kwargs):
    print(f"+ {' '.join(str(c) for c in cmd)}")
    subprocess.run(cmd, check=True, **kwargs)


def pkgver():
    match = re.search(r"^pkgver=(\S+)$", PKGBUILD.read_text(), flags=re.MULTILINE)
    if not match:
        print(f"release-helper: no pkgver= line found in {PKGBUILD}", file=sys.stderr)
        sys.exit(1)
    return match.group(1)


def sign(key, target):
    run([
        "gpg", "--batch", "--yes", "--detach-sign",
        "--local-user", key, "-o", f"{target}.sig", str(target),
    ])


def verify(target):
    """Confirm the detached signature really covers the package.

    A signing step that silently no-ops would otherwise look identical
    to a successful one until an end user's own verification failed.
    """
    result = subprocess.run(
        ["gpg", "--verify", f"{target}.sig", str(target)],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print(f"release-helper: {target}.sig does not verify against {target}", file=sys.stderr)
        print(result.stderr.strip(), file=sys.stderr)
        sys.exit(1)
    print(f"  verified {target.name}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--key", required=True, help="signing key fingerprint")
    args = parser.parse_args()

    version = pkgver()
    tag = f"helper-v{version}"

    if RELEASE_DIR.exists():
        for stale in RELEASE_DIR.iterdir():
            stale.unlink()
    RELEASE_DIR.mkdir(parents=True, exist_ok=True)

    with tempfile.TemporaryDirectory() as tmp:
        build_dir = Path(tmp)
        shutil.copy(PKGBUILD, build_dir / "PKGBUILD")
        run(["makepkg", "-f"], cwd=build_dir)

        built = sorted(build_dir.glob("*.pkg.tar.zst"))
        if len(built) != 1:
            print(f"release-helper: expected exactly one built package, found {built}", file=sys.stderr)
            sys.exit(1)

        pkg = RELEASE_DIR / built[0].name
        shutil.copy(built[0], pkg)
        sign(args.key, pkg)

    print("release-helper: verifying the signature before reporting success")
    verify(pkg)

    if any(target.is_symlink() for target in RELEASE_DIR.iterdir()):
        print("release-helper: packaging/release/ contains a symlink, which the marketplace rejects", file=sys.stderr)
        sys.exit(1)

    digest = subprocess.run(
        ["sha256sum", pkg.name], cwd=RELEASE_DIR, capture_output=True, text=True, check=True,
    ).stdout.split()[0]

    print(f"\nrelease-helper: wrote {RELEASE_DIR}")
    print(f"release-helper: pkgver {version}, sha256 {digest}")
    print("release-helper: put that exact sha256 in README.md, commit packaging/release/,")
    print("release-helper: then publish this one version with:")
    print(f"  gh release create {tag} packaging/release/{pkg.name} packaging/release/{pkg.name}.sig "
          f"--title 'omarchy-powerplan-helper {version}' --notes 'Signed helper package for pkgver {version}.'")
    print("release-helper: never reuse this tag for a different pkgver. A new helper version")
    print("release-helper: gets a new pkgver, a new tag, and a new security review.")


if __name__ == "__main__":
    main()
