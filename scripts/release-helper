#!/usr/bin/python3
"""Build and sign a release of the privileged helper package.

Maintainer-only. Run from the repository root whenever
powerplan-configure-hibernate changes:

    ./scripts/release-helper --key A8238083DE096BC875CD1EB572BD2077B316056A

This builds the package with makepkg, signs it with a detached
signature, and rebuilds the signed pacman repository database in
packaging/repo/.

End users never run this and never build anything. They trust the
maintainer key once, add the repository to pacman.conf once, and from
then on pacman verifies both the repository database and the package
against that key on every install and upgrade.

packaging/repo/ is an exact mirror of what the release serves: the six
file names pacman can request, as real files. The marketplace rejects
any repository containing a symlink, and repo-add produces symlinks by
default, so the database is built in a scratch directory and only its
real files are moved into place.

After running this, commit packaging/repo/ and upload its contents to
the GitHub release that hosts the repository. The exact upload command
is printed at the end.
"""
import argparse
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PKGBUILD_DIR = ROOT / "packaging" / "pkgbuild"
REPO_DIR = ROOT / "packaging" / "repo"
REPO_NAME = "omarchy-powerplan"
RELEASE_TAG = "repo"


def run(cmd, **kwargs):
    print(f"+ {' '.join(str(c) for c in cmd)}")
    subprocess.run(cmd, check=True, **kwargs)


def sign(key, target):
    run([
        "gpg", "--batch", "--yes", "--detach-sign",
        "--local-user", key, "-o", f"{target}.sig", str(target),
    ])


def verify(target):
    """Confirm a detached signature really covers its target.

    repo-add reports a database signing failure as a warning and still
    exits zero, so an unverified release would otherwise look like a
    successful one.
    """
    result = subprocess.run(
        ["gpg", "--verify", f"{target}.sig", str(target)],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print(f"release-helper: {target}.sig does not verify against {target}", file=sys.stderr)
        print(result.stderr.strip(), file=sys.stderr)
        sys.exit(1)
    print(f"  verified {target.name}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--key", required=True, help="signing key fingerprint")
    args = parser.parse_args()

    if REPO_DIR.exists():
        for stale in REPO_DIR.iterdir():
            stale.unlink()
    REPO_DIR.mkdir(parents=True, exist_ok=True)

    with tempfile.TemporaryDirectory() as tmp:
        build_dir = Path(tmp)
        shutil.copy(PKGBUILD_DIR / "PKGBUILD", build_dir / "PKGBUILD")
        run(["makepkg", "-f"], cwd=build_dir)

        built = sorted(build_dir.glob("*.pkg.tar.zst"))
        if len(built) != 1:
            print(f"release-helper: expected exactly one built package, found {built}", file=sys.stderr)
            sys.exit(1)

        pkg = REPO_DIR / built[0].name
        shutil.copy(built[0], pkg)
        sign(args.key, pkg)

        # repo-add writes <name>.db.tar.gz plus a <name>.db symlink
        # beside it. Build it out of tree so only the real files land
        # in the published directory.
        staging = build_dir / "db"
        staging.mkdir()
        run(
            ["repo-add", "--sign", "--verify", "--key", args.key,
             str(staging / f"{REPO_NAME}.db.tar.gz"), str(pkg)],
            cwd=staging,
        )

        for suffix in ("db", "files"):
            source = staging / f"{REPO_NAME}.{suffix}.tar.gz"
            target = REPO_DIR / f"{REPO_NAME}.{suffix}"
            shutil.copy(source, target)
            signature = Path(f"{source}.sig")
            if signature.exists():
                shutil.copy(signature, f"{target}.sig")
            else:
                sign(args.key, target)

    print("release-helper: verifying every signature before reporting success")
    for target in sorted(REPO_DIR.iterdir()):
        if target.suffix != ".sig":
            verify(target)

    if any(target.is_symlink() for target in REPO_DIR.iterdir()):
        print("release-helper: packaging/repo/ contains a symlink, which the marketplace rejects", file=sys.stderr)
        sys.exit(1)

    uploads = " ".join(sorted(target.name for target in REPO_DIR.iterdir()))
    print(f"\nrelease-helper: wrote {REPO_DIR}")
    print("release-helper: commit packaging/repo/, then publish the repository with:")
    print(f"  cd {REPO_DIR} && gh release upload {RELEASE_TAG} --clobber {uploads}")


if __name__ == "__main__":
    main()
